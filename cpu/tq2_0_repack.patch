+static int repack_tq2_0_to_tq2_0_4_bl(struct ggml_tensor * t, const void * GGML_RESTRICT data, size_t data_size) {
+    GGML_ASSERT(t->type == GGML_TYPE_TQ2_0);
+    constexpr int nrows_interleaved = 4;
+
+    block_tq2_0x4 *     dst = (block_tq2_0x4 *) t->data;
+    const block_tq2_0 * src = (const block_tq2_0 *) data;
+    const int nrow    = ggml_nrows(t);
+    const int nblocks = t->ne[0] / QK_K;
+
+    GGML_ASSERT(data_size == nrow * nblocks * sizeof(block_tq2_0));
+
+    if (t->ne[1] % nrows_interleaved != 0) {
+        return -1;
+    }
+
+    for (int b = 0; b < nrow; b += nrows_interleaved) {
+        for (int64_t x = 0; x < nblocks; x++) {
+            block_tq2_0x4 out;
+            memset(out.qs, 0, sizeof(out.qs));
+            for (int j = 0; j < nrows_interleaved; j++) {
+                const block_tq2_0 * in = &src[x + j * nblocks];
+                out.d[j] = in->d;
+                for (int k = 0; k < QK_K; k++) {
+                    // TQ2_0: k = 128*h + 32*l + m is in byte 32*h + m, bits 2l
+                    const int h = k / 128, l = (k % 128) / 32, m = k % 32;
+                    const uint8_t code = (in->qs[32*h + m] >> (2*l)) & 3;
+                    const int g = k / 32, c = (k % 32) / 8, i = k % 8, p = j / 2;
+                    out.qs[(2*g + p)*16 + (j % 2)*8 + i] |= code << (2*c);
+                }
+            }
+            *dst++ = out;
+        }
+        src += nrows_interleaved * nblocks;
+    }
+    return 0;
+}
