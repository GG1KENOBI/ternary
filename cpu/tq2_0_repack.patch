@@ -1586,6 +1590,81 @@ void ggml_vec_dot_tq2_0_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const vo
 
     const int nb = n / QK_K;
 
+#if defined(__ARM_FEATURE_MATMUL_INT8)
+    if (nrc == 2) {
+        // 2 rows x 2 columns: each weight block is unpacked once and used for both columns via smmla
+        const block_tq2_0 * GGML_RESTRICT x0 = x;
+        const block_tq2_0 * GGML_RESTRICT x1 = (const block_tq2_0 *) ((const uint8_t *) vx + bx);
+        const block_q8_K  * GGML_RESTRICT y0 = y;
+        const block_q8_K  * GGML_RESTRICT y1 = (const block_q8_K  *) ((const uint8_t *) vy + by);
+
+        const uint8x16_t m3 = vdupq_n_u8(3);
+        float32x4_t sumv = vdupq_n_f32(0.0f);
+
+        for (int i = 0; i < nb; ++i) {
+            // 4 independent accumulators so that smmla latency does not serialize the loop
+            int32x4_t acc0 = vdupq_n_s32(0);
+            int32x4_t acc1 = vdupq_n_s32(0);
+            int32x4_t acc2 = vdupq_n_s32(0);
+            int32x4_t acc3 = vdupq_n_s32(0);
+
+            for (size_t j = 0; j < sizeof(x->qs); j += 32) {
+                const uint8x16_t a0 = vld1q_u8(x0[i].qs + j);
+                const uint8x16_t a1 = vld1q_u8(x0[i].qs + j + 16);
+                const uint8x16_t b0 = vld1q_u8(x1[i].qs + j);
+                const uint8x16_t b1 = vld1q_u8(x1[i].qs + j + 16);
+                const int8_t * GGML_RESTRICT q0 = y0[i].qs + j*4;
+                const int8_t * GGML_RESTRICT q1 = y1[i].qs + j*4;
+
+#define TQ2_ZIP1(u, v) vreinterpretq_s8_s64(vzip1q_s64(vreinterpretq_s64_s8(u), vreinterpretq_s64_s8(v)))
+#define TQ2_ZIP2(u, v) vreinterpretq_s8_s64(vzip2q_s64(vreinterpretq_s64_s8(u), vreinterpretq_s64_s8(v)))
+#define TQ2_STEP(acc, A0, A1, B0, B1, off) { \
+                    const int8x16_t xa0 = vreinterpretq_s8_u8(vandq_u8(A0, m3)); \
+                    const int8x16_t xa1 = vreinterpretq_s8_u8(vandq_u8(A1, m3)); \
+                    const int8x16_t xb0 = vreinterpretq_s8_u8(vandq_u8(B0, m3)); \
+                    const int8x16_t xb1 = vreinterpretq_s8_u8(vandq_u8(B1, m3)); \
+                    const int8x16_t ya0 = vld1q_s8(q0 + (off));      \
+                    const int8x16_t ya1 = vld1q_s8(q0 + (off) + 16); \
+                    const int8x16_t yb0 = vld1q_s8(q1 + (off));      \
+                    const int8x16_t yb1 = vld1q_s8(q1 + (off) + 16); \
+                    acc = vmmlaq_s32(acc, TQ2_ZIP1(xa0, xb0), TQ2_ZIP1(ya0, yb0)); \
+                    acc = vmmlaq_s32(acc, TQ2_ZIP2(xa0, xb0), TQ2_ZIP2(ya0, yb0)); \
+                    acc = vmmlaq_s32(acc, TQ2_ZIP1(xa1, xb1), TQ2_ZIP1(ya1, yb1)); \
+                    acc = vmmlaq_s32(acc, TQ2_ZIP2(xa1, xb1), TQ2_ZIP2(ya1, yb1)); }
+                TQ2_STEP(acc0, a0,                 a1,                 b0,                 b1,                  0)
+                TQ2_STEP(acc1, vshrq_n_u8(a0, 2),  vshrq_n_u8(a1, 2),  vshrq_n_u8(b0, 2),  vshrq_n_u8(b1, 2),  32)
+                TQ2_STEP(acc2, vshrq_n_u8(a0, 4),  vshrq_n_u8(a1, 4),  vshrq_n_u8(b0, 4),  vshrq_n_u8(b1, 4),  64)
+                TQ2_STEP(acc3, vshrq_n_u8(a0, 6),  vshrq_n_u8(a1, 6),  vshrq_n_u8(b0, 6),  vshrq_n_u8(b1, 6),  96)
+#undef TQ2_STEP
+#undef TQ2_ZIP2
+#undef TQ2_ZIP1
+            }
+
+            int32x4_t acc = vaddq_s32(vaddq_s32(acc0, acc1), vaddq_s32(acc2, acc3));
+
+            // codes are q+1: subtract the column sums of y
+            const int32_t s0 = vaddvq_s32(vpaddlq_s16(vaddq_s16(vld1q_s16(y0[i].bsums), vld1q_s16(y0[i].bsums + 8))));
+            const int32_t s1 = vaddvq_s32(vpaddlq_s16(vaddq_s16(vld1q_s16(y1[i].bsums), vld1q_s16(y1[i].bsums + 8))));
+            const int32_t _ys[4] = { s0, s1, s0, s1 };
+            acc = vsubq_s32(acc, vld1q_s32(_ys));
+
+            const float dx0 = GGML_CPU_FP16_TO_FP32(x0[i].d);
+            const float dx1 = GGML_CPU_FP16_TO_FP32(x1[i].d);
+            const float _scale[4] = { dx0*y0[i].d, dx0*y1[i].d, dx1*y0[i].d, dx1*y1[i].d };
+            sumv = vmlaq_f32(sumv, vcvtq_f32_s32(acc), vld1q_f32(_scale));
+        }
+
+        // sumv = [x0y0, x0y1, x1y0, x1y1] -> s[0..1] = column 0, s[bs..bs+1] = column 1
+        const float32x4_t sumv1 = vextq_f32(sumv, sumv, 2);
+        const float32x4_t sumv2 = vzip1q_f32(sumv, sumv1);
+
+        vst1_f32(s,      vget_low_f32 (sumv2));
+        vst1_f32(s + bs, vget_high_f32(sumv2));
+
+        return;
+    }
+#endif
+
 #if defined(__ARM_NEON)
     float sumf = 0.0f;
 
diff --git a/ggml/src/ggml-cpu/arch/arm/repack.cpp b/ggml/src/ggml-cpu/arch/arm/repack.cpp
index ad0e5cc..3afe9cf 100644
--- a/ggml/src/ggml-cpu/arch/arm/repack.cpp
+++ b/ggml/src/ggml-cpu/arch/arm/repack.cpp
@@ -5463,3 +5463,187 @@ void ggml_gemm_q1_0_4x8_q8_0(int                        n,
 
     ggml_gemm_q1_0_4x8_q8_0_generic(n, s, bs, vx, vy, nr, nc);
 }
+
+// TQ2_0 interleaved by 4 rows (block_tq2_0x4, see repack.h): codes are q + 1, so the sum of the activations
+// is subtracted once per block.
+void ggml_gemv_tq2_0_4x8_q8_K(int                        n,
+                              float * GGML_RESTRICT      s,
+                              size_t                     bs,
+                              const void * GGML_RESTRICT vx,
+                              const void * GGML_RESTRICT vy,
+                              int                        nr,
+                              int                        nc) {
+    const int nb = n / QK_K;
+
+    assert(n % QK_K == 0);
+    assert(nc % 4 == 0);
+
+    UNUSED(nb);
+
+#if defined(__aarch64__) && defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+    const uint8x16_t m3 = vdupq_n_u8(3);
+
+    for (int x = 0; x < nc; x += 4) {
+        const block_tq2_0x4 * b_ptr = (const block_tq2_0x4 *) vx + (x / 4) * nb;
+        const block_q8_K    * a_ptr = (const block_q8_K *) vy;
+        float32x4_t acc = vdupq_n_f32(0);
+
+        for (int b = 0; b < nb; b++, a_ptr++, b_ptr++) {
+            int32x4_t i0a = vdupq_n_s32(0), i0b = vdupq_n_s32(0);
+            int32x4_t i1a = vdupq_n_s32(0), i1b = vdupq_n_s32(0);
+
+            for (int g = 0; g < 8; g++) {
+                const uint8x16_t w0 = vld1q_u8(b_ptr->qs + (2*g + 0)*16);
+                const uint8x16_t w1 = vld1q_u8(b_ptr->qs + (2*g + 1)*16);
+                const int8x16_t  q0 = vld1q_s8(a_ptr->qs + 32*g);
+                const int8x16_t  q1 = vld1q_s8(a_ptr->qs + 32*g + 16);
+                const int8x16_t  a0 = vcombine_s8(vget_low_s8 (q0), vget_low_s8 (q0));
+                const int8x16_t  a1 = vcombine_s8(vget_high_s8(q0), vget_high_s8(q0));
+                const int8x16_t  a2 = vcombine_s8(vget_low_s8 (q1), vget_low_s8 (q1));
+                const int8x16_t  a3 = vcombine_s8(vget_high_s8(q1), vget_high_s8(q1));
+
+                i0a = vdotq_s32(i0a, vreinterpretq_s8_u8(vandq_u8(w0, m3)), a0);
+                i1a = vdotq_s32(i1a, vreinterpretq_s8_u8(vandq_u8(w1, m3)), a0);
+                i0b = vdotq_s32(i0b, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(w0, 2), m3)), a1);
+                i1b = vdotq_s32(i1b, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(w1, 2), m3)), a1);
+                i0a = vdotq_s32(i0a, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(w0, 4), m3)), a2);
+                i1a = vdotq_s32(i1a, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(w1, 4), m3)), a2);
+                i0b = vdotq_s32(i0b, vreinterpretq_s8_u8(vshrq_n_u8(w0, 6)), a3);
+                i1b = vdotq_s32(i1b, vreinterpretq_s8_u8(vshrq_n_u8(w1, 6)), a3);
+            }
+
+            // lanes of i0: [row0 k0-3, row0 k4-7, row1 k0-3, row1 k4-7] -> pairwise sums give rows 0..3
+            int32x4_t r = vpaddq_s32(vaddq_s32(i0a, i0b), vaddq_s32(i1a, i1b));
+            const int32_t asum = vaddvq_s32(vpaddlq_s16(vaddq_s16(vld1q_s16(a_ptr->bsums), vld1q_s16(a_ptr->bsums + 8))));
+            r = vsubq_s32(r, vdupq_n_s32(asum));
+
+            const float32x4_t dw = vcvt_f32_f16(vld1_f16((const __fp16 *) b_ptr->d));
+            acc = vfmaq_f32(acc, vcvtq_f32_s32(r), vmulq_n_f32(dw, a_ptr->d));
+        }
+        vst1q_f32(s + x, acc);
+    }
+    return;
+#endif
+    ggml_gemv_tq2_0_4x8_q8_K_generic(n, s, bs, vx, vy, nr, nc);
+}
+
+#if defined(__aarch64__) && defined(__ARM_NEON) && defined(__ARM_FEATURE_MATMUL_INT8)
+// One tile: 4 weight rows (x .. x+3) x 4*NA activation rows (y .. y+4*NA-1). Each unpacked weight operand feeds
+// 2*NA smmla, so NA = 2 halves the unpacking work per multiply compared to a 4x4 tile.
+template <int NA>
+static inline void tq2_0_4x8_q8_K_tile(int nb, float * GGML_RESTRICT s, size_t bs,
+                                       const block_tq2_0x4 * GGML_RESTRICT b_ptr, const block_q8_Kx4 * GGML_RESTRICT a_base) {
+    const uint8x16_t m3 = vdupq_n_u8(3);
+
+    // f[p][q]: weight rows 2p, 2p+1 x activation rows 2q, 2q+1 as [w0a0, w0a1, w1a0, w1a1]
+    float32x4_t f[2][2*NA];
+    for (int p = 0; p < 2; p++) {
+        for (int q = 0; q < 2*NA; q++) {
+            f[p][q] = vdupq_n_f32(0);
+        }
+    }
+
+    for (int b = 0; b < nb; b++, b_ptr++) {
+        int32x4_t acc[2][2*NA];
+        for (int p = 0; p < 2; p++) {
+            for (int q = 0; q < 2*NA; q++) {
+                acc[p][q] = vdupq_n_s32(0);
+            }
+        }
+
+        for (int g = 0; g < 8; g++) {
+            const uint8x16_t w0 = vld1q_u8(b_ptr->qs + (2*g + 0)*16);
+            const uint8x16_t w1 = vld1q_u8(b_ptr->qs + (2*g + 1)*16);
+
+            for (int c = 0; c < 4; c++) {
+                const uint8x16_t u0 = c == 0 ? w0 : vshlq_u8(w0, vdupq_n_s8(-2*c));
+                const uint8x16_t u1 = c == 0 ? w1 : vshlq_u8(w1, vdupq_n_s8(-2*c));
+                const int8x16_t  x0 = vreinterpretq_s8_u8(c == 3 ? u0 : vandq_u8(u0, m3));
+                const int8x16_t  x1 = vreinterpretq_s8_u8(c == 3 ? u1 : vandq_u8(u1, m3));
+                for (int t = 0; t < NA; t++) {
+                    const int8_t * GGML_RESTRICT a = a_base[t * nb + b].qs + 128*g + 32*c;
+                    const int8x16_t a01 = vld1q_s8(a);
+                    const int8x16_t a23 = vld1q_s8(a + 16);
+                    acc[0][2*t + 0] = vmmlaq_s32(acc[0][2*t + 0], x0, a01);
+                    acc[0][2*t + 1] = vmmlaq_s32(acc[0][2*t + 1], x0, a23);
+                    acc[1][2*t + 0] = vmmlaq_s32(acc[1][2*t + 0], x1, a01);
+                    acc[1][2*t + 1] = vmmlaq_s32(acc[1][2*t + 1], x1, a23);
+                }
+            }
+        }
+
+        const float32x4_t dw  = vcvt_f32_f16(vld1_f16((const __fp16 *) b_ptr->d));
+        const float32x4_t dwp[2] = { vzip1q_f32(dw, dw), vzip2q_f32(dw, dw) };
+
+        for (int t = 0; t < NA; t++) {
+            const block_q8_Kx4 * GGML_RESTRICT a_ptr = &a_base[t * nb + b];
+
+            // activation row sums: bsums[16*a + 4*row + b] over a, b = 0..3
+            const int16_t * bsums = a_ptr->bsums;
+            const int16x8_t s01 = vaddq_s16(vaddq_s16(vld1q_s16(bsums +  0), vld1q_s16(bsums + 16)),
+                                            vaddq_s16(vld1q_s16(bsums + 32), vld1q_s16(bsums + 48)));
+            const int16x8_t s23 = vaddq_s16(vaddq_s16(vld1q_s16(bsums +  8), vld1q_s16(bsums + 24)),
+                                            vaddq_s16(vld1q_s16(bsums + 40), vld1q_s16(bsums + 56)));
+            const int32x4_t asum = vpaddq_s32(vpaddlq_s16(s01), vpaddlq_s16(s23));
+            const int32x4_t asq[2] = { vcombine_s32(vget_low_s32(asum), vget_low_s32(asum)),
+                                       vcombine_s32(vget_high_s32(asum), vget_high_s32(asum)) };
+
+            const float32x4_t da = vld1q_f32(a_ptr->d);
+            const float32x4_t daq[2] = { vcombine_f32(vget_low_f32(da), vget_low_f32(da)),
+                                         vcombine_f32(vget_high_f32(da), vget_high_f32(da)) };
+
+            for (int p = 0; p < 2; p++) {
+                for (int h = 0; h < 2; h++) {
+                    const int q = 2*t + h;
+                    f[p][q] = vfmaq_f32(f[p][q], vcvtq_f32_s32(vsubq_s32(acc[p][q], asq[h])), vmulq_f32(dwp[p], daq[h]));
+                }
+            }
+        }
+    }
+
+    for (int q = 0; q < 2*NA; q++) {
+        vst1q_f32(s + (2*q + 0) * bs, vuzp1q_f32(f[0][q], f[1][q]));
+        vst1q_f32(s + (2*q + 1) * bs, vuzp2q_f32(f[0][q], f[1][q]));
+    }
+}
+#endif
+
+void ggml_gemm_tq2_0_4x8_q8_K(int                        n,
+                              float * GGML_RESTRICT      s,
+                              size_t                     bs,
+                              const void * GGML_RESTRICT vx,
+                              const void * GGML_RESTRICT vy,
+                              int                        nr,
+                              int                        nc) {
+    const int nb = n / QK_K;
+
+    assert(n % QK_K == 0);
+    assert(nr % 4 == 0);
+    assert(nc % 4 == 0);
+
+    UNUSED(nb);
+
+#if defined(__aarch64__) && defined(__ARM_NEON) && defined(__ARM_FEATURE_MATMUL_INT8)
+    int y = 0;
+    for (; y + 16 <= nr; y += 16) {
+        const block_q8_Kx4 * a_base = (const block_q8_Kx4 *) vy + (y / 4) * nb;
+        for (int x = 0; x < nc; x += 4) {
+            tq2_0_4x8_q8_K_tile<4>(nb, s + y * bs + x, bs, (const block_tq2_0x4 *) vx + (x / 4) * nb, a_base);
+        }
+    }
+    for (; y + 8 <= nr; y += 8) {
+        const block_q8_Kx4 * a_base = (const block_q8_Kx4 *) vy + (y / 4) * nb;
+        for (int x = 0; x < nc; x += 4) {
+            tq2_0_4x8_q8_K_tile<2>(nb, s + y * bs + x, bs, (const block_tq2_0x4 *) vx + (x / 4) * nb, a_base);
+        }
+    }
+    for (; y < nr; y += 4) {
+        const block_q8_Kx4 * a_base = (const block_q8_Kx4 *) vy + (y / 4) * nb;
+        for (int x = 0; x < nc; x += 4) {
+            tq2_0_4x8_q8_K_tile<1>(nb, s + y * bs + x, bs, (const block_tq2_0x4 *) vx + (x / 4) * nb, a_base);
+        }
+    }
+    return;
+#endif
+    ggml_gemm_tq2_0_4x8_q8_K_generic(n, s, bs, vx, vy, nr, nc);
+}
diff --git a/ggml/src/ggml-cpu/arch/x86/repack.cpp b/ggml/src/ggml-cpu/arch/x86/repack.cpp
index af1ceba..f531991 100644
--- a/ggml/src/ggml-cpu/arch/x86/repack.cpp
+++ b/ggml/src/ggml-cpu/arch/x86/repack.cpp
@@ -6405,3 +6405,174 @@ void ggml_gemm_q2_K_8x8_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const vo
 
 #endif
 }
+
+// TQ2_0 interleaved by 4 rows (block_tq2_0x4, see repack.h). One 32-byte load holds a group of 32 weights of all
+// 4 rows; shift + mask of bit field c gives [r0 k0..7, r1 k0..7, r2 k0..7, r3 k0..7] for k = 32*g + 8*c + i, codes q + 1.
+// maddubs (u8 codes x s8 activations) sums stay within int16 for a whole 256-block (32 * 2 * 2 * 127 = 16256).
+#if defined(__AVX2__)
+// activation row sums of a block_q8_Kx4: bsums[16*a + 4*row + b] over a, b = 0..3 -> [s0, s1, s0, s1 | s2, s3, s2, s3]
+static inline __m256i tq2_0_q8_Kx4_rowsums(const block_q8_Kx4 * GGML_RESTRICT a) {
+    const __m256i * bs = (const __m256i *) a->bsums;
+    const __m256i s = _mm256_add_epi16(_mm256_add_epi16(_mm256_loadu_si256(bs + 0), _mm256_loadu_si256(bs + 1)),
+                                       _mm256_add_epi16(_mm256_loadu_si256(bs + 2), _mm256_loadu_si256(bs + 3)));
+    const __m256i t = _mm256_madd_epi16(s, _mm256_set1_epi16(1)); // [s0, s0, s1, s1 | s2, s2, s3, s3] partials
+    return _mm256_hadd_epi32(t, t);
+}
+
+// One tile: 4 weight rows x 4*NA activation rows.
+template <int NA>
+static inline void tq2_0_4x8_q8_K_tile_avx2(int nb, float * GGML_RESTRICT s, size_t bs,
+                                            const block_tq2_0x4 * GGML_RESTRICT b_ptr, const block_q8_Kx4 * GGML_RESTRICT a_base) {
+    const __m256i m3   = _mm256_set1_epi8(3);
+    const __m256i ones = _mm256_set1_epi16(1);
+
+    // F[t][h]: activation rows 4t + 2h, 4t + 2h + 1; lanes (m, r) = (0,0) (0,1) (1,0) (1,1) | (0,2) (0,3) (1,2) (1,3)
+    __m256 F[NA][2];
+    for (int t = 0; t < NA; t++) {
+        F[t][0] = _mm256_setzero_ps();
+        F[t][1] = _mm256_setzero_ps();
+    }
+
+    const __m256i idx_dw  = _mm256_setr_epi32(0, 1, 0, 1, 2, 3, 2, 3);
+    const __m256i idx_h0  = _mm256_setr_epi32(0, 0, 1, 1, 0, 0, 1, 1);
+    const __m256i idx_h1  = _mm256_setr_epi32(2, 2, 3, 3, 2, 2, 3, 3);
+    const __m256i idx_as0 = _mm256_setr_epi32(0, 0, 1, 1, 0, 0, 1, 1);
+    const __m256i idx_as1 = _mm256_setr_epi32(4, 4, 5, 5, 4, 4, 5, 5);
+
+    for (int b = 0; b < nb; b++, b_ptr++) {
+        __m256i acc[4*NA];
+        for (int m = 0; m < 4*NA; m++) {
+            acc[m] = _mm256_setzero_si256();
+        }
+
+        for (int g = 0; g < 8; g++) {
+            const __m256i w = _mm256_loadu_si256((const __m256i *) (b_ptr->qs + 32*g));
+            for (int c = 0; c < 4; c++) {
+                const __m256i x = _mm256_and_si256(_mm256_srli_epi16(w, 2*c), m3);
+                for (int t = 0; t < NA; t++) {
+                    const int8_t * GGML_RESTRICT a = a_base[t * nb + b].qs + 128*g + 32*c;
+                    for (int m = 0; m < 4; m++) {
+                        const __m256i av = _mm256_set1_epi64x(*(const int64_t *) (a + 8*m));
+                        acc[4*t + m] = _mm256_add_epi16(acc[4*t + m], _mm256_maddubs_epi16(x, av));
+                    }
+                }
+            }
+        }
+
+        const __m128  dw4 = _mm_setr_ps(GGML_CPU_FP16_TO_FP32(b_ptr->d[0]), GGML_CPU_FP16_TO_FP32(b_ptr->d[1]),
+                                       GGML_CPU_FP16_TO_FP32(b_ptr->d[2]), GGML_CPU_FP16_TO_FP32(b_ptr->d[3]));
+        const __m256  dw  = _mm256_permutevar8x32_ps(_mm256_set_m128(dw4, dw4), idx_dw);
+
+        for (int t = 0; t < NA; t++) {
+            const block_q8_Kx4 * GGML_RESTRICT a_ptr = &a_base[t * nb + b];
+            const __m256i v0 = _mm256_madd_epi16(acc[4*t + 0], ones);
+            const __m256i v1 = _mm256_madd_epi16(acc[4*t + 1], ones);
+            const __m256i v2 = _mm256_madd_epi16(acc[4*t + 2], ones);
+            const __m256i v3 = _mm256_madd_epi16(acc[4*t + 3], ones);
+            const __m256i h01 = _mm256_hadd_epi32(v0, v1); // [m0r0 m0r1 m1r0 m1r1 | m0r2 m0r3 m1r2 m1r3]
+            const __m256i h23 = _mm256_hadd_epi32(v2, v3);
+
+            const __m256i as = tq2_0_q8_Kx4_rowsums(a_ptr); // [s0 s1 s0 s1 | s2 s3 s2 s3]
+            const __m256 da4 = _mm256_set_m128(_mm_loadu_ps(a_ptr->d), _mm_loadu_ps(a_ptr->d));
+
+            F[t][0] = _mm256_fmadd_ps(_mm256_cvtepi32_ps(_mm256_sub_epi32(h01, _mm256_permutevar8x32_epi32(as, idx_as0))),
+                                      _mm256_mul_ps(dw, _mm256_permutevar8x32_ps(da4, idx_h0)), F[t][0]);
+            F[t][1] = _mm256_fmadd_ps(_mm256_cvtepi32_ps(_mm256_sub_epi32(h23, _mm256_permutevar8x32_epi32(as, idx_as1))),
+                                      _mm256_mul_ps(dw, _mm256_permutevar8x32_ps(da4, idx_h1)), F[t][1]);
+        }
+    }
+
+    const __m256i idx_out = _mm256_setr_epi32(0, 1, 4, 5, 2, 3, 6, 7);
+    for (int t = 0; t < NA; t++) {
+        for (int h = 0; h < 2; h++) {
+            const __m256 o = _mm256_permutevar8x32_ps(F[t][h], idx_out); // [row 2h: r0..r3 | row 2h+1: r0..r3]
+            _mm_storeu_ps(s + (4*t + 2*h + 0) * bs, _mm256_castps256_ps128(o));
+            _mm_storeu_ps(s + (4*t + 2*h + 1) * bs, _mm256_extractf128_ps(o, 1));
+        }
+    }
+}
+#endif
+
+void ggml_gemv_tq2_0_4x8_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int nb = n / QK_K;
+
+    assert(n % QK_K == 0);
+    assert(nc % 4 == 0);
+
+    UNUSED(nb);
+
+#if defined(__AVX2__)
+    const __m256i m3   = _mm256_set1_epi8(3);
+    const __m256i ones = _mm256_set1_epi16(1);
+
+    for (int x = 0; x < nc; x += 4) {
+        const block_tq2_0x4 * b_ptr = (const block_tq2_0x4 *) vx + (x / 4) * nb;
+        const block_q8_K    * a_ptr = (const block_q8_K *) vy;
+        __m256 acc = _mm256_setzero_ps();
+
+        for (int b = 0; b < nb; b++, a_ptr++, b_ptr++) {
+            __m256i s0 = _mm256_setzero_si256();
+            __m256i s1 = _mm256_setzero_si256();
+
+            for (int g = 0; g < 8; g++) {
+                const __m256i w = _mm256_loadu_si256((const __m256i *) (b_ptr->qs + 32*g));
+                const int64_t * q = (const int64_t *) (a_ptr->qs + 32*g);
+                s0 = _mm256_add_epi16(s0, _mm256_maddubs_epi16(_mm256_and_si256(w, m3),                     _mm256_set1_epi64x(q[0])));
+                s1 = _mm256_add_epi16(s1, _mm256_maddubs_epi16(_mm256_and_si256(_mm256_srli_epi16(w, 2), m3), _mm256_set1_epi64x(q[1])));
+                s0 = _mm256_add_epi16(s0, _mm256_maddubs_epi16(_mm256_and_si256(_mm256_srli_epi16(w, 4), m3), _mm256_set1_epi64x(q[2])));
+                s1 = _mm256_add_epi16(s1, _mm256_maddubs_epi16(_mm256_and_si256(_mm256_srli_epi16(w, 6), m3), _mm256_set1_epi64x(q[3])));
+            }
+
+            // [r0 r0 r1 r1 | r2 r2 r3 r3] partial sums; the column sum is subtracted from the even lanes only
+            const __m256i v = _mm256_madd_epi16(_mm256_add_epi16(s0, s1), ones);
+            const __m128i bsum = _mm_add_epi16(_mm_loadu_si128((const __m128i *) a_ptr->bsums),
+                                               _mm_loadu_si128((const __m128i *) (a_ptr->bsums + 8)));
+            __m128i t = _mm_madd_epi16(bsum, _mm_set1_epi16(1));
+            t = _mm_hadd_epi32(t, t);
+            t = _mm_hadd_epi32(t, t);
+            const int32_t asum = _mm_cvtsi128_si32(t);
+            const __m256i corr = _mm256_setr_epi32(asum, 0, asum, 0, asum, 0, asum, 0);
+
+            const __m128 dw4 = _mm_setr_ps(GGML_CPU_FP16_TO_FP32(b_ptr->d[0]), GGML_CPU_FP16_TO_FP32(b_ptr->d[1]),
+                                       GGML_CPU_FP16_TO_FP32(b_ptr->d[2]), GGML_CPU_FP16_TO_FP32(b_ptr->d[3]));
+            const __m256 dw  = _mm256_permutevar8x32_ps(_mm256_set_m128(dw4, dw4), _mm256_setr_epi32(0, 0, 1, 1, 2, 2, 3, 3));
+            acc = _mm256_fmadd_ps(_mm256_cvtepi32_ps(_mm256_sub_epi32(v, corr)), _mm256_mul_ps(dw, _mm256_set1_ps(a_ptr->d)), acc);
+        }
+
+        // pairwise sums -> rows 0..3
+        const __m256 h = _mm256_hadd_ps(acc, acc); // [r0 r1 r0 r1 | r2 r3 r2 r3]
+        const __m128 r = _mm_shuffle_ps(_mm256_castps256_ps128(h), _mm256_extractf128_ps(h, 1), _MM_SHUFFLE(1, 0, 1, 0));
+        _mm_storeu_ps(s + x, r);
+    }
+    return;
+#endif
+    ggml_gemv_tq2_0_4x8_q8_K_generic(n, s, bs, vx, vy, nr, nc);
+}
+
+void ggml_gemm_tq2_0_4x8_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int nb = n / QK_K;
+
+    assert(n % QK_K == 0);
+    assert(nr % 4 == 0);
+    assert(nc % 4 == 0);
+
+    UNUSED(nb);
+
+#if defined(__AVX2__)
+    int y = 0;
+    for (; y + 8 <= nr; y += 8) {
+        const block_q8_Kx4 * a_base = (const block_q8_Kx4 *) vy + (y / 4) * nb;
+        for (int x = 0; x < nc; x += 4) {
+            tq2_0_4x8_q8_K_tile_avx2<2>(nb, s + y * bs + x, bs, (const block_tq2_0x4 *) vx + (x / 4) * nb, a_base);
+        }
+    }
+    for (; y < nr; y += 4) {
+        const block_q8_Kx4 * a_base = (const block_q8_Kx4 *) vy + (y / 4) * nb;
+        for (int x = 0; x < nc; x += 4) {
+            tq2_0_4x8_q8_K_tile_avx2<1>(nb, s + y * bs + x, bs, (const block_tq2_0x4 *) vx + (x / 4) * nb, a_base);
+        }
+    }
+    return;
+#endif
+    ggml_gemm_tq2_0_4x8_q8_K_generic(n, s, bs, vx, vy, nr, nc);
+}
