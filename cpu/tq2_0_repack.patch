+static inline int tq2_0x4_value(const block_tq2_0x4 * b, int j, int k) {
+    const int g = k / 32, c = (k % 32) / 8, i = k % 8, p = j / 2;
+    return ((b->qs[(2*g + p)*16 + (j % 2)*8 + i] >> (2*c)) & 3) - 1;
+}
+
+void ggml_gemv_tq2_0_4x8_q8_K_generic(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int nb = n / QK_K;
+    assert(n % QK_K == 0);
+    assert(nc % 4 == 0);
+    UNUSED(bs);
+    UNUSED(nr);
+
+    const block_q8_K * a_ptr = (const block_q8_K *) vy;
+    for (int x = 0; x < nc / 4; x++) {
+        const block_tq2_0x4 * b_ptr = (const block_tq2_0x4 *) vx + (x * nb);
+        float sumf[4] = { 0 };
+        for (int l = 0; l < nb; l++) {
+            for (int j = 0; j < 4; j++) {
+                int sumi = 0;
+                for (int k = 0; k < QK_K; k++) {
+                    sumi += tq2_0x4_value(&b_ptr[l], j, k) * a_ptr[l].qs[k];
+                }
+                sumf[j] += sumi * GGML_CPU_FP16_TO_FP32(b_ptr[l].d[j]) * a_ptr[l].d;
+            }
+        }
+        for (int j = 0; j < 4; j++) {
+            s[x * 4 + j] = sumf[j];
+        }
+    }
+}
+
+void ggml_gemm_tq2_0_4x8_q8_K_generic(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int nb = n / QK_K;
+    assert(n % QK_K == 0);
+    assert(nr % 4 == 0);
+    assert(nc % 4 == 0);
+
+    for (int y = 0; y < nr / 4; y++) {
+        const block_q8_Kx4 * a_ptr = (const block_q8_Kx4 *) vy + (y * nb);
+        for (int x = 0; x < nc / 4; x++) {
+            const block_tq2_0x4 * b_ptr = (const block_tq2_0x4 *) vx + (x * nb);
+            float sumf[4][4] = { { 0 } };
+            for (int l = 0; l < nb; l++) {
+                for (int m = 0; m < 4; m++) {
+                    for (int j = 0; j < 4; j++) {
+                        int sumi = 0;
+                        for (int k = 0; k < QK_K; k++) {
+                            // q8_Kx4 with blocklen 8: chunk k/8 holds 8 values of each of the 4 rows in turn
+                            sumi += tq2_0x4_value(&b_ptr[l], j, k) * a_ptr[l].qs[(k / 8) * 32 + m * 8 + k % 8];
+                        }
+                        sumf[m][j] += sumi * GGML_CPU_FP16_TO_FP32(b_ptr[l].d[j]) * a_ptr[l].d[m];
+                    }
+                }
+            }
+            for (int m = 0; m < 4; m++) {
+                for (int j = 0; j < 4; j++) {
+                    s[(y * 4 + m) * bs + x * 4 + j] = sumf[m][j];
+                }
+            }
+        }
+    }
+}
